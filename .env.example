# ===== PostgreSQL =====
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=rag
POSTGRES_PASSWORD=change_me
POSTGRES_DB=rag_agent

# TypeORM 连接串
DATABASE_URL=postgres://rag:change_me@localhost:5432/rag_agent

# ===== 服务端口 =====
API_PORT=3000
WEB_PORT=5173
API_BASE_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:5173

# ========== 通用配置 ==========
# 所有 LLM 服务共享的 API Key（适用于统一认证的平台）
LLM_API_KEY=sk-your-api-key

# 所有 LLM 服务的 Base URL（统一入口）
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ========== 各功能专用配置（可选覆盖） ==========
# 如果不同功能使用不同的服务端点，可单独覆盖
LLM_CHAT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_RERANK_BASE_URL=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-api/v1

# 模型名称
LLM_CHAT_MODEL=glm-5
LLM_EMBEDDING_MODEL=qwen3.7-text-embedding
LLM_RERANK_MODEL=qwen3-rerank